# ---------------------------------------------------------------------------
# Production cloud app (Vite) — these three are the only values the web/APK
# build needs. Everything below is for local tooling or the legacy Express
# reference and is NOT exposed to the browser.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=https://your-project.supabase.co/functions/v1/api

# ---------------------------------------------------------------------------
# Runtime (legacy Express/SQLite reference)
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public origin of the app (used for absolute links, CORS and APK/PWA config)
APP_ORIGIN=http://localhost:4000
PUBLIC_APP_URL=http://localhost:4000
TRUST_PROXY=false
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# PostgreSQL
# Local dev:   postgres://postgres@localhost:55432/banan
# Production:  Supabase pooler connection string (IPv4) + ?sslmode=require
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://postgres@localhost:55432/banan
PG_POOL_MAX=10
RUN_MIGRATIONS=true

# ---------------------------------------------------------------------------
# File storage
# STORAGE_DRIVER=local  -> data/uploads (development)
# STORAGE_DRIVER=supabase -> Supabase Storage bucket (production)
# ---------------------------------------------------------------------------
STORAGE_DRIVER=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=fund-files

# ---------------------------------------------------------------------------
# Local admin scripts (never expose to the browser)
# ---------------------------------------------------------------------------
SUPABASE_ACCESS_TOKEN=
SEED_PASSWORD=
SUPABASE_BACKUP_BUCKET=fund-backups

# ---------------------------------------------------------------------------
# Web Push (VAPID). Generate once with: npx web-push generate-vapid-keys
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Set to true only when running behind a trusted reverse proxy / load balancer
# LOG_LEVEL=info
